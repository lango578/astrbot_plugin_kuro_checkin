{
    "token": {
        "description": "库街区 token（user_token）",
        "type": "string",
        "hint": "可选。更推荐用 /库街区登录 <手机号> 一键登录（自动过滑块+短信验证码）。也可在 www.kurobbs.com 登录后 F12 → Cookies 复制 user_token 值，或 /库街区绑定 <token>。",
        "obvious_hint": true
    },
    "auto_sign_enable": {
        "description": "每天自动签到",
        "type": "bool",
        "default": true
    },
    "auto_sign_time": {
        "description": "每天自动签到时间（24小时制，服务器时区）",
        "type": "string",
        "default": "07:30"
    },
    "push_result": {
        "description": "自动签到完成后推送到你绑定/签到时所在的会话",
        "type": "bool",
        "default": true
    },
    "enable_wuwa": {
        "description": "启用鸣潮游戏签到",
        "type": "bool",
        "default": true
    },
    "enable_pgr": {
        "description": "启用战双游戏签到",
        "type": "bool",
        "default": true
    },
    "enable_forum_sign": {
        "description": "启用库街区社区签到（获得库洛币）",
        "type": "bool",
        "default": true
    },
    "enable_forum_tasks": {
        "description": "启用论坛每日任务（浏览/点赞/分享，可额外获得库洛币）",
        "type": "bool",
        "default": false
    }
}
